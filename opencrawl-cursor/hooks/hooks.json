{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "afterAgentThought": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "opencrawl collect hook --harness cursor --plugin-hook",
        "timeout": 30
      }
    ]
  }
}
