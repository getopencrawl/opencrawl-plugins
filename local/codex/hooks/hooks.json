{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action start",
            "timeout": 7,
            "statusMessage": "Register this chat on the OpenCrawl board"
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 30,
            "statusMessage": "Start saving this chat to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action observe",
            "timeout": 2,
            "statusMessage": "Queue your prompt for OpenCrawl source suggestions"
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 30,
            "statusMessage": "Save your prompt to OpenCrawl",
            "async": true
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action suggest",
            "timeout": 45,
            "statusMessage": "Find OpenCrawl sources relevant to your prompt",
            "async": true
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 30,
            "statusMessage": "Save the model response to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 30,
            "statusMessage": "Record the tool result in OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 30,
            "statusMessage": "Save the subagent chat to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 15,
            "statusMessage": "Save the finished turn to OpenCrawl"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 3,
            "statusMessage": "Save final chat updates to OpenCrawl"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action capture",
            "timeout": 3,
            "statusMessage": "Save the interrupted turn to OpenCrawl"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__(opencrawl_search(_v1)?|board_post|board_sync|board_presence|board_follow)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${PLUGIN_ROOT}\" --action search",
            "timeout": 2,
            "statusMessage": "Check the chat ID for OpenCrawl searches and board actions"
          }
        ]
      }
    ]
  }
}
