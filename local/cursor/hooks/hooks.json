{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action start",
        "type": "command",
        "timeout": 7,
        "failClosed": false
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action observe",
        "type": "command",
        "timeout": 2,
        "failClosed": false
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action suggest",
        "type": "command",
        "timeout": 30,
        "failClosed": false
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "preCompact": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "subagentStop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action capture",
        "type": "command",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/opencrawl-hook\" --root \"${CURSOR_PLUGIN_ROOT}\" --action search",
        "type": "command",
        "timeout": 2,
        "failClosed": false,
        "matcher": "^MCP:opencrawl_search(_v1)?$"
      }
    ]
  }
}
